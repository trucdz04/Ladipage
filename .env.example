# MCP secrets — used by Claude's .mcp.json and Codex's .codex/config.toml.
# Set these as ENVIRONMENT VARIABLES; neither client auto-loads this file.
#
# On Windows (PowerShell), set them persistently as User-scope env vars:
#   [Environment]::SetEnvironmentVariable("FIRECRAWL_API_KEY","<value>","User")
#   [Environment]::SetEnvironmentVariable("API_KEY_21ST","<value>","User")
#   [Environment]::SetEnvironmentVariable("LARK_APP_ID","<value>","User")
#   [Environment]::SetEnvironmentVariable("LARK_APP_SECRET","<value>","User")
# Then restart Codex/Claude so the MCP processes receive the new values.

FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
API_KEY_21ST=21st_sk_your-magic-key-here
LARK_APP_ID=cli_your-lark-app-id-here
LARK_APP_SECRET=your-lark-app-secret-here

# n8n MCP (required only when Codex/Claude must inspect or manage an n8n instance)
N8N_API_URL=https://your-n8n.example.com
N8N_API_KEY=your-n8n-api-key
# Optional: n8n instance-level MCP features
N8N_MCP_ACCESS_TOKEN=your-n8n-mcp-access-token

# Meta Ads MCP
META_ADS_ACCESS_TOKEN=your-meta-marketing-api-token
META_AD_ACCOUNT_ID=123456789
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_BUSINESS_ID=your-meta-business-id

# --- n8n automation workflow (ngoài các biến kết nối MCP ở trên) ---
# Meta Conversions API
META_PIXEL_ID=your-pixel-or-dataset-id
META_CAPI_TOKEN=your-conversions-api-token
# Lark Bitable lưu khách (Leads) + nội dung email (Email Content)
LARK_BITABLE_APP_TOKEN=your-bitable-app-token
LARK_LEADS_TABLE_ID=tblxxxxxxxx
LARK_CONTENT_TABLE_ID=tblxxxxxxxx
# API kiểm tra lead đã đăng ký trên app chính (trả {"registered":true/false})
CINAI_CHECK_URL=https://app.cinai.tv/api/leads/status
# Cho phép hash SHA-256 trong Code node của n8n
# NODE_FUNCTION_ALLOW_BUILTIN=crypto

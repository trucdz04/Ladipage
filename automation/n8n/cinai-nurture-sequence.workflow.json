      "id": "a0000000-0000-4000-8000-000000000005",
      "name": "Lark Get Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [440, 320],
      "onError": "continueRegularOutput", "retryOnFail": true, "maxTries": 2

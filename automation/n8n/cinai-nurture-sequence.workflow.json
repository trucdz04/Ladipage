    {
      "parameters": {
        "jsCode": "// Build noi dung email tu Lark Content (loc theo Campaign), co fallback mac dinh.\nconst lead = $('Normalize').item.json;\nconst recs = (($input.first().json || {}).data || {}).items || [];\n\n// DEFAULT (dung khi Lark chua co noi dung) — chinh sua chinh thuc tren Lark.\nconst DEFAULT = {\n  email_0: { subject: 'Quà của bạn đây, {{name}} 🎁', body: '<p>Chào {{name}},</p><p>Đây là tài liệu/quà bạn vừa yêu cầu. Trải nghiệm nhanh CinAI để biến nó thành kết quả thật.</p>', cta_text: 'Dùng thử CinAI miễn phí', cta_path: '/signup' },\n  email_1: { subject: '{{name}} ơi, mất hàng giờ làm video?', body: '<p>Chào {{name}},</p><p>Làm nội dung/video thủ công vừa lâu vừa tốn. CinAI giúp bạn tạo nhanh chỉ trong vài phút.</p>', cta_text: 'Xem CinAI làm việc đó thế nào', cta_path: '/signup' },\n  email_2: { subject: 'Người khác đã làm được, còn bạn?', body: '<p>Chào {{name}},</p><p>Nhiều người dùng đã rút ngắn 80% thời gian sản xuất nhờ CinAI. Bạn chỉ cần 1 lần thử.</p>', cta_text: 'Tạo sản phẩm đầu tiên', cta_path: '/signup' },\n  email_3: { subject: 'Mẹo tuần này cho {{name}}', body: '<p>Chào {{name}},</p><p>Một mẹo nhỏ giúp bạn dùng CinAI hiệu quả hơn. Đăng nhập để thử ngay.</p>', cta_text: 'Vào CinAI', cta_path: '/signup' }\n};\n\nconst fromLark = {};\nfor (const r of recs) {\n  const f = r.fields || {};\n  const step = f.Step || f.step;\n  if (!step) continue;\n  if (f.Campaign && f.Campaign !== lead.campaign) continue;\n  fromLark[step] = { subject: f.Subject||'', body: f.Body||'', cta_text: f['CTA Text']||'', cta_path: f['CTA Path']||'/signup' };\n}\n\nconst BASE = 'https://cinai.tv';\nfunction fill(s){ return String(s||'').split('{{name}}').join(lead.name); }\nfunction build(step){\n  const c = Object.assign({}, DEFAULT[step], fromLark[step]||{});\n  const url = BASE + (c.cta_path||'/signup') + '?utm_source=n8n_email&utm_medium=email&utm_campaign=' + encodeURIComponent(lead.campaign) + '&utm_content=' + step + '&email=' + encodeURIComponent(lead.email);\n  const cta = '<p style=\"margin:24px 0\"><a href=\"' + url + '\" style=\"background:#6d28d9;color:#fff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:600\">' + (c.cta_text||'Vào CinAI') + ' →</a></p>';\n  const html = '<div style=\"font-family:sans-serif;font-size:16px;line-height:1.6;color:#1a1a1a\">' + fill(c.body) + cta + '<p style=\"font-size:12px;color:#888\">Bạn nhận email này vì đã để lại thông tin tại CinAI. <a href=\"' + BASE + '/unsubscribe?email=' + encodeURIComponent(lead.email) + '\">Huỷ nhận</a>.</p></div>';\n  return { subject: fill(c.subject), html };\n}\n\nreturn [{ json: { ...lead, content: { email_0: build('email_0'), email_1: build('email_1'), email_2: build('email_2'), email_3: build('email_3') } } }];"
      },

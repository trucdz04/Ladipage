  "content": "<!-- wp:html -->\n<style id=\"lmt-design-v2\">\n:root{--lmt-ink:#1f2520;--lmt-muted:#626861;--lmt-canvas:#fbfaf7;--lmt-surface:#ffffff;--lmt-soft:#f3f1eb;--lmt-line:#dedbd2;--lmt-line-strong:#c8c3b7;--lmt-navy:#0a1530;--lmt-teal:#0b6b5b;--lmt-blue:#155eef;--lmt-orange:#c75234;--lmt-yellow:#f5d75e;--lmt-shadow:0 1px 0 rgba(31,37,32,.05),0 8px 24px rgba(31,37,32,.08)}\nbody{background:var(--lmt-canvas);color:var(--lmt-ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;text-rendering:optimizeLegibility}body a{color:#0b5cad;text-decoration-thickness:1px;text-underline-offset:3px}body a:hover{color:#083f77}.wp-site-blocks{background:var(--lmt-canvas)}header.wp-block-template-part{position:sticky;top:0;z-index:50;background:rgba(251,250,247,.92);backdrop-filter:saturate(160%) blur(12px);border-bottom:1px solid var(--lmt-line)}header.wp-block-template-part a{text-decoration:none}footer.wp-block-template-part{border-top:1px solid var(--lmt-line);background:#fff}.lmt-wrap,.lmt-hub,.lmt-blog{max-width:1120px;margin:0 auto;padding:28px 18px;color:var(--lmt-ink);font-size:17px;line-height:1.68}.lmt-wrap *,.lmt-hub *,.lmt-blog *{box-sizing:border-box}.lmt-hero{display:grid;gap:24px;align-items:start;padding:40px 0 34px;border-bottom:1px solid var(--lmt-line)}.lmt-hero-split{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:28px;align-items:stretch}.lmt-kicker,.lmt-eyebrow{display:inline-flex;width:max-content;align-items:center;gap:8px;border:1px solid #cfe3dc;background:#edf7f3;color:#075747;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:750;text-transform:uppercase;letter-spacing:0}.lmt-h1{font-size:clamp(36px,5vw,58px);line-height:1.06;margin:12px 0 16px;letter-spacing:0;font-weight:760}.lmt-lead{font-size:clamp(18px,2vw,21px);line-height:1.58;color:var(--lmt-muted);max-width:820px;margin:0}.lmt-actions{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.lmt-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;padding:12px 16px;min-height:46px;text-decoration:none!important;font-weight:750;line-height:1.2;border:1px solid transparent;transition:transform .16s ease,box-shadow .16s ease,background .16s ease}.lmt-btn:hover{transform:translateY(-1px);box-shadow:var(--lmt-shadow)}.lmt-btn-primary,.lmt-btn:not(.secondary):not(.lmt-btn-secondary){background:var(--lmt-navy);color:#fff!important}.lmt-btn-secondary,.lmt-btn.secondary{background:#fff;color:var(--lmt-ink)!important;border-color:var(--lmt-line-strong)}.lmt-btn-accent{background:var(--lmt-teal);color:#fff!important}.lmt-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:28px 0}.lmt-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.lmt-card{border:1px solid var(--lmt-line);border-radius:8px;background:var(--lmt-surface);padding:20px;box-shadow:0 1px 0 rgba(31,37,32,.03);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.lmt-card:hover{transform:translateY(-2px);border-color:var(--lmt-line-strong);box-shadow:var(--lmt-shadow)}.lmt-card h2,.lmt-card h3{margin:0 0 8px;line-height:1.22;letter-spacing:0}.lmt-card p{color:var(--lmt-muted);margin:0 0 12px}.lmt-section{border-top:1px solid var(--lmt-line);padding-top:34px;margin-top:34px}.lmt-section h2{font-size:clamp(26px,3vw,38px);line-height:1.15;margin:0 0 14px;letter-spacing:0}.lmt-section h3,.lmt-post h3{font-size:22px;line-height:1.25;margin:24px 0 10px;letter-spacing:0}.lmt-post h2{font-size:clamp(25px,3vw,34px);line-height:1.18;margin:34px 0 12px;letter-spacing:0}.lmt-muted,.lmt-small{color:var(--lmt-muted)}.lmt-small{font-size:14px}.lmt-note,.lmt-trustbar{border:1px solid #edd5c8;border-left:4px solid var(--lmt-orange);background:#fff7f3;border-radius:8px;padding:16px 18px;margin:22px 0;color:#4e2b1f}.lmt-trustbar{max-width:1120px;margin:18px auto;padding:14px 18px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;font-size:14px}
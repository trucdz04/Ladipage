-size:14px}.lmt-index-item:hover{border-color:var(--lmt-teal);box-shadow:var(--lmt-shadow)}@media(max-width:900px){.lmt-hero-split,.lmt-grid,.lmt-grid.two,.lmt-related-grid,.lmt-metric-row{grid-template-columns:1fr}.lmt-actions .lmt-btn{width:100%}.lmt-wrap,.lmt-hub,.lmt-blog{padding:22px 16px;font-size:16px}.lmt-trustbar{margin-left:16px;margin-right:16px}.lmt-index-item{grid-template-columns:1fr}.lmt-h1{font-size:34px}}\n\nmain h1.wp-block-post-title{max-width:1120px;margin:54px auto 24px!important;padding:0 18px;font-size:clamp(38px,4.5vw,58px)!important;line-height:1.08!important;font-weight:680!important;letter-spacing:0!important;color:var(--lmt-ink)}.wp-block-post-content{margin-top:0!important}.lmt-blog,.lmt-hub,.lmt-wrap{padding-top:18px}@media(max-width:900px){main h1.wp-block-post-title{margin:30px auto 16px!important;font-size:32px!important}.lmt-blog,.lmt-hub,.lmt-wrap{padding-top:12px}}</style>\n<style id=\"lmt-ux-polish-v3\">.lmt-image-hero{max-width:1120px;margin:18px auto 30px;padding:0 18px}.lmt-image-hero img{display:block!important;width:100%!important;height:auto!important;aspect-ratio:16/9;object-fit:cover;border-radius:8px;border:1px solid var(--lmt-line,#dedbd2);box-shadow:0 1px 0 rgba(31,37,32,.04),0 14px 34px rgba(31,37,32,.10);background:#fff}.lmt-image-hero figcaption{margin-top:9px;color:var(--lmt-muted,#626861);font-size:13px;line-height:1.45}.wp-block-post-featured-image img,.wp-block-image img{height:auto;border-radius:8px;border:1px solid var(--lmt-line,#dedbd2);box-shadow:0 1px 0 rgba(31,37,32,.04),0 10px 24px rgba(31,37,32,.08)}.wp-block-query .wp-block-post{border:1px solid var(--lmt-line,#dedbd2);border-radius:8px;background:#fff;padding:18px;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.wp-block-query .wp-block-post:hover{transform:translateY(-2px);border-color:var(--lmt-line-strong,#c8c3b7);box-shadow:0 1px 0 rgba(31,37,32,.04),0 10px 24px rgba(31,37,32,.08)}.lmt-visual-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:22px 0}.lmt-visual-card{display:flex;flex-direction:column;gap:10px;border:1px solid var(--lmt-line,#dedbd2);border-radius:8px;background:#fff;padding:12px;text-decoration:none!important;color:var(--lmt-ink,#1f2520)!important;box-shadow:0 1px 0 rgba(31,37,32,.03);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.lmt-visual-card:hover{transform:translateY(-2px);border-color:var(--lmt-line-strong,#c8c3b7);box-shadow:0 1px 0 rgba(31,37,32,.04),0 12px 28px rgba(31,37,32,.10)}.lmt-visual-card img{display:block!important;width:100%!important;height:auto!important;aspect-ratio:16/9;object-fit:cover;border-radius:6px;border:1px solid var(--lmt-line,#dedbd2);box-shadow:none;background:#fff}.lmt-visual-card strong{font-size:18px;line-height:1.28;letter-spacing:0}.lmt-visual-card em{font-style:normal;color:var(--lmt-muted,#626861);font-size:14px;line-height:1.5}.lmt-card,.lmt-index-item,.lmt-related a{will-change:transform}.lmt-card h3 a,.wp-block-post-title a{text-decoration:none}.lmt-post>p:first-of-type{font-size:18px;line-height:1.65;color:var(--lmt-ink,#1f2520)}@media(max-width:900px){.lmt-visual-list{grid-template-columns:1fr}.lmt-visual-card{padding:10px}}@media(max-width:700px){.lmt-image-hero{margin:12px auto 22px;padding:0 16px}.lmt-image-hero figcaption{font-size:12px}.wp-block-query .wp-block-post{padding:15px}}</style>\n<style id=\"lmt-home-v4\">body.home h1.wp-block-post-title,body.page-id-30 h1.wp-block-post-title{display:none!important}.lmt-cov-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:24px 0}.lmt-cov-card{display:block;border:1px solid var(--lmt-line);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none!important;color:var(--lmt-ink)!important;box-shadow:0 1px 0 rgba(31,37,32,.03);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.lmt-cov-card:hover{transform:translateY(-3px);box-shadow:var(--lmt-shadow
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = (item.body && Object.keys(item.body).length) ? item.body : item;\nreturn [{ json: {\n  name: b.name || 'bạn',\n  email: (b.email||'').trim().toLowerCase(),\n  gift: b.gift || b.content_name || 'tai_lieu',\n  campaign: b.campaign || b.utm_campaign || 'nurture_default',\n  utm_source: b.utm_source || 'n8n_email',\n  fbp: b.fbp || '', fbc: b.fbc || ''\n} }];"
      },
